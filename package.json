{
  "name": "card-pricer",
  "version": "1.0.0",
  "description": "Real-time trading card pricing app for shows — AI-powered card identification with Cardmarket & eBay pricing",
  "type": "module",
  "main": "apps/server/server.js",
  "scripts": {
    "prestart": "node --check apps/server/server.js",
    "start": "node apps/server/server.js",
    "dev": "node apps/server/server.js",
    "test": "node --test --test-reporter=spec \"tests/**/*.spec.js\"",
    "test:watch": "node --test --watch --test-reporter=spec \"tests/**/*.spec.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@sentry/node": "^10.0.0",
    "@supabase/supabase-js": "^2.104.0",
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.3.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^10.0.0",
    "prom-client": "^15.0.0",
    "sharp": "^0.33.0",
    "stripe": "^22.0.2"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "pino-pretty": "^13.0.0"
  }
}
