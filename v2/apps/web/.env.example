# Web app environment. Copy to .env for local dev.
# Server-only vars start with no prefix; client-exposed vars need PUBLIC_ prefix.

# Supabase (server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (client)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Pricing data partners
POKEMON_TCG_API_KEY=
JUSTTCG_API_KEY=
RAPIDAPI_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Brevo (email)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_NEWSLETTER_LIST_ID=

# Single-tenant fallback (matches v1's env)
SHOP_EMAIL=dave@boardandbrewed.ie
SHOP_NAME=Board & Brewed

# IP hashing for quote_leads.ip_hash (any random 32+ char string)
IP_HASH_SALT=
