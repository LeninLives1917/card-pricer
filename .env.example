# ===========================================
# CARD PRICER — Environment Configuration
# ===========================================
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# --- Required ---
# Anthropic API key for Claude Vision (card identification)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- eBay API (for sold listings comparison) ---
# Register at: https://developer.ebay.com/
# Create an app → get production App ID + Cert ID
EBAY_APP_ID=your-ebay-app-id
EBAY_CERT_ID=your-ebay-cert-id

# --- Cardmarket ---
# No key needed! Uses live scraping of actual Cardmarket listings
# filtered by English language + matching condition.

# --- Supabase (auth + user data) ---
# Required for Phase B auth. Create a project at https://supabase.com,
# paste the schema from docs, then grab these from Settings → API.
# Service role key is SECRET — never commit, never expose to the browser.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Settings ---
PORT=3000
DEFAULT_BUY_PERCENTAGE=60
