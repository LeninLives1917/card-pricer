# =====================================================================
# Card-Pricer V2 — Environment Configuration
# =====================================================================
# Owner: A8 | Slice: S4 | See docs/V2_ARCHITECTURE.md §1, V2_AUDIT.md §4
#
# Copy this file to .env at the repo root and fill in your keys:
#     cp infra/env.example .env
#
# Mirrors infra/render.yaml exactly. If you add a var here, add it there
# too (and vice versa). The repo-root .env.example is the V1 file and
# is kept around only for the V1 production deploy until cutover.
#
# Legend:
#   REQUIRED — server fails to boot or returns 503 on /api/* without this
#   OPTIONAL — server boots without it; the dependent feature degrades
#   DEFAULT  — server has a built-in fallback if unset
# =====================================================================


# ---------------------------------------------------------------------
# Anthropic — REQUIRED
# ---------------------------------------------------------------------
# Claude Vision: identify (Sonnet 4.6), read-set-code, double-check, and
# the Q3 OCR-first validation gate. Hoisted to a single IDENT_MODEL
# constant in pricing/identify-core.js — bumping models is one PR.
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx


# ---------------------------------------------------------------------
# Supabase — REQUIRED (auth + persistence)
# ---------------------------------------------------------------------
# Service-role key bypasses RLS — NEVER ship to the browser, NEVER commit.
# Without these, every authed /api/* path returns 503.
# SUPABASE_ANON_KEY is hardcoded in apps/vendor/index.html (and the V2
# customer/quote apps); rotating the project means editing those files.
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...


# ---------------------------------------------------------------------
# Stripe — OPTIONAL (subscription billing; checkout/portal return 503 if absent)
# ---------------------------------------------------------------------
# Webhook secret is signature-verified against req.rawBody (V2_AUDIT §5.12).
# Six price IDs map to plan/interval pairs (server.js ~611–618). They MUST
# match the Stripe live-mode prices or paying customers get the wrong plan.
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRICE_SOLO_MONTHLY=price_xxxxx
STRIPE_PRICE_SOLO_YEARLY=price_xxxxx
STRIPE_PRICE_VENDOR_MONTHLY=price_xxxxx
STRIPE_PRICE_VENDOR_YEARLY=price_xxxxx
STRIPE_PRICE_SHOP_MONTHLY=price_xxxxx
STRIPE_PRICE_SHOP_YEARLY=price_xxxxx


# ---------------------------------------------------------------------
# Brevo — OPTIONAL (transactional emails + newsletter)
# ---------------------------------------------------------------------
# Lead capture persists to quote_leads BEFORE Brevo is called (V2_AUDIT §5.13)
# so a Brevo outage cannot lose leads.
BREVO_API_KEY=xkeysib-xxxxx
BREVO_SENDER_EMAIL=no-reply@your-domain.example
BREVO_NEWSLETTER_LIST_ID=0


# ---------------------------------------------------------------------
# eBay sold-comps — OPTIONAL (priceEbaySold disabled if absent)
# ---------------------------------------------------------------------
# Marketplace is hardcoded EBAY_IE in server.js. Register at:
#   https://developer.ebay.com/  → Production keys.
EBAY_APP_ID=your-ebay-app-id
EBAY_CERT_ID=your-ebay-cert-id


# ---------------------------------------------------------------------
# Third-party pricing APIs — OPTIONAL (each adapter no-ops on absence)
# ---------------------------------------------------------------------
# JustTCG: TCGPlayer USD, all games. 100 req/day free.
JUSTTCG_API_KEY=your-justtcg-key
# RapidAPI / TCGGO: Cardmarket EUR + graded comps + DE/FR/ES/IT lows
# (the highest-priority EUR source today; see pricing/confidence.js).
RAPIDAPI_KEY=your-rapidapi-key
# pokemontcg.io: lifts rate limit 30/min → 20k/day. Recommended in prod.
POKEMON_TCG_API_KEY=your-pokemontcg-key


# ---------------------------------------------------------------------
# Card DB source — OPTIONAL (operator-editable Google Sheet override)
# ---------------------------------------------------------------------
# Published-CSV URL. If set, initCardDb() prefers Sheet → file → pokemontcg.io.
# Persistent disk (Render Starter, Q2) means data/card-db.json now survives
# redeploys; the Sheet stays the single human-editable source of truth.
CARD_DB_SHEET_URL=


# ---------------------------------------------------------------------
# Single-tenant fallbacks — OPTIONAL (DEFAULT supplied in code)
# ---------------------------------------------------------------------
# Used when /api/quote-lead can't resolve a shop row. Per-shop overrides
# in the shops table take precedence.
SHOP_NAME=Card Pricer
SHOP_EMAIL=dave@boardandbrewed.ie


# ---------------------------------------------------------------------
# Privacy — OPTIONAL (DEFAULT 'card-pricer-default-salt')
# ---------------------------------------------------------------------
# Daily-rotated SHA-256 salt for quote_leads.ip_hash. Set this in prod
# so leaked DB dumps cannot be IP-correlated against rainbow tables.
IP_HASH_SALT=change-me-in-production


# =====================================================================
# V2-NEW — feature flags (post-V1 additions)
# =====================================================================

# OCR-first scan path (Q3 / F24). DEFAULT false.
# When true, /api/read-set-code → /api/identify-manual is fronted by an
# image-compare validation gate (pricing/ocr-first/validation.js). Toggle
# without redeploy if accuracy regresses.
OCR_FIRST_ENABLED=false

# Sessions cutover read flip (F17). DEFAULT false (= read JSONB blob).
# A3 dual-writes to user_state + sessions/session_cards through phase 3.
# Flip true near end of phase 4 once parity tests are green.
READ_FROM_RELATIONAL=false


# =====================================================================
# V2-NEW — observability (Q5 / F13)
# =====================================================================

# Sentry server SDK DSN (infra/observability/sentry-server.js). OPTIONAL —
# init no-ops if absent so dev/test don't ship phantom events.
SENTRY_DSN_SERVER=

# Sentry browser SDK DSN. Imported by vendor + quote + customer apps.
# Different DSN from server (different Sentry "project" for cleaner
# stack-trace grouping).
SENTRY_DSN_BROWSER=

# Sentry environment tag. DEFAULT production. Override to "staging" or
# "dev" on long-lived non-prod environments so prod alert channels stay clean.
SENTRY_ENVIRONMENT=production

# Build-time injected git SHA. Surfaced via /api/version. Set by the
# Render build hook (or `git rev-parse HEAD` in CI). Falls back to
# "unknown" if absent.
GIT_SHA=

# Build timestamp injected by the Render build step (e.g.
# `date -u +%Y-%m-%dT%H:%M:%SZ`). Surfaced via /api/version. Falls back
# to null if absent.
BUILT_AT=

# Optional Prometheus scraper bearer token. When set, requests to
# /api/metrics with Authorization: Bearer <token> bypass the Supabase
# auth round-trip. Leave unset to require admin JWT only (safe default).
METRICS_TOKEN=

# pino log level: trace | debug | info | warn | error | fatal. DEFAULT info.
# In dev set to debug; in prod keep info to control log volume costs.
LOG_LEVEL=info


# =====================================================================
# V2 sealed pricing (S17) — paid TCGPlayer Pro tier
# =====================================================================

# TCGPlayer Pro API key. Paid tier (~€60/mo). When unset (and
# TCGPLAYER_PRO_MOCK is not 'true'), /api/v2/price-sealed returns 503
# cleanly. /api/v2/price (single-card) is unaffected.
TCGPLAYER_PRO_API_KEY=

# Base URL override for TCGPlayer Pro. DEFAULT https://api.tcgplayer.com/.
# DevOps overrides when the actual paid-tier path differs.
TCGPLAYER_PRO_BASE_URL=https://api.tcgplayer.com/

# Set to 'true' on staging / preview / tests to exercise the sealed
# pipeline with realistic-shape mock data (no real API calls). DEFAULT
# false (real API calls when TCGPLAYER_PRO_API_KEY is set).
TCGPLAYER_PRO_MOCK=false


# =====================================================================
# Runtime — NON-SECRET defaults
# =====================================================================

# Node version pin. 20.10.0 is what Render's preinstalled image ships
# (commits 7954a10 + 36871d3 explain the pin: corepack/pnpm bootstrap
# bugs on 20.x earlier). Bump in lockstep with package.json#engines.
NODE_VERSION=20.10.0

# NODE_ENV controls pino's pretty/JSON mode + Express's error verbosity.
NODE_ENV=production

# Listen port. Render injects its own; this DEFAULT exists for local dev.
PORT=3000

# Default vendor buy-% if the request body omits buyPercentage (server.js 4728).
DEFAULT_BUY_PERCENTAGE=60
